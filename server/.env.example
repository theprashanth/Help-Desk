# ── Required in production (NODE_ENV=production): the server won't start without them ──
NODE_ENV=production
# MongoDB Atlas connection string (Database › Connect › Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/help-desk?retryWrites=true&w=majority
# A long random secret for sign-in tokens: run `openssl rand -hex 32`
JWT_SECRET=replace-with-64-random-hex-characters
# Your dashboard's address (Netlify). Also the only website allowed to call this API from a browser.
DASHBOARD_URL=https://your-site.netlify.app

# ── Optional ──
# This server's own public address (used for links to uploaded files in emails)
PUBLIC_API_URL=https://your-server.onrender.com
# Extra dashboard addresses, comma-separated (e.g. a custom domain as well as the Netlify one)
# CORS_ORIGINS=https://help.yourco.com,https://your-site.netlify.app
# Stop new companies from creating workspaces (single-company install)
# ALLOW_SIGNUP=false
# Create the test admin (admin@localhost / admin123) on an empty database. Never on a real install.
# SEED_DEMO_ADMIN=true
PORT=3000

# ── Local development only ──
# USE_LOCAL_STORAGE=true   (store data in server/.data/ JSON files instead of MongoDB)
