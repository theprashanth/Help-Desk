# ── Required in production (NODE_ENV=production): the server won't start without them ──
NODE_ENV=production
# MongoDB Atlas connection string (Database › Connect › Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/help-desk?retryWrites=true&w=majority
# A long random secret for sign-in tokens: run `openssl rand -hex 32`
JWT_SECRET=replace-with-64-random-hex-characters
# Your dashboard's address. Also the only website allowed to call this API from a browser.
DASHBOARD_URL=https://help.yourco.com

# ── Optional ──
# This server's own public address: links to attachments and profile pictures (in chats and emails) use it.
# Strongly recommended; without it the address is taken from each request.
PUBLIC_API_URL=https://your-server.onrender.com
# Extra dashboard addresses, comma-separated (e.g. two domains for the same dashboard)
# CORS_ORIGINS=https://help.yourco.com,https://support.yourco.com
# Stop new companies from creating workspaces (single-company install)
# ALLOW_SIGNUP=false
# Create the test admin (admin@localhost / admin123) on an empty database. Never on a real install.
# SEED_DEMO_ADMIN=true
# The Testing panel (seed demo data / reset the workspace) is off in production. Staging servers only:
# ALLOW_TESTING_TOOLS=true
PORT=3000

# ── Your own user database (optional) ──
# Signed-in users' phone, name and email are read from here by their user id (verified users only).
# Use a read-only database user. Leave USER_DIRECTORY_URI empty to turn this off.
# USER_DIRECTORY_URI=mongodb+srv://readonly:PASSWORD@your-cluster.mongodb.net/your-app-db
# USER_DIRECTORY_APP_ID=your-messenger-app-id   (Settings › Messenger Live Chat › Install)
# USER_DIRECTORY_COLLECTION=users
# USER_DIRECTORY_ID_FIELD=_id
# USER_DIRECTORY_PHONE_FIELD=phone              (dotted paths work: profile.mobile)
# USER_DIRECTORY_NAME_FIELD=name                (or: firstName lastName)
# USER_DIRECTORY_EMAIL_FIELD=email

# GIF search in the reply box (⋯ › GIFs). Free key at https://developers.giphy.com. Without it,
# teammates can still paste a GIF link.
GIPHY_API_KEY=

# ── Local development only ──
# USE_LOCAL_STORAGE=true   (store data in server/.data/ JSON files instead of MongoDB)
